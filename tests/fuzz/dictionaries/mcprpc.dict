# libFuzzer dictionary for the mcprpc target: JSON-RPC framing, the MCP method
# names, and the tool arguments the servers branch on. The format is gated on
# exact strings, so a mutation that cannot spell "tools/call" never reaches a
# handler at all.

"{\"jsonrpc\":\"2.0\","
"\"jsonrpc\""
"\"2.0\""
"\"id\""
"\"method\""
"\"params\""
"\"result\""
"\"error\""

"\"initialize\""
"\"notifications/initialized\""
"\"notifications/cancelled\""
"\"tools/list\""
"\"tools/call\""
"\"ping\""

"\"protocolVersion\""
"\"2025-11-25\""
"\"2025-06-18\""
"\"2024-11-05\""
"\"capabilities\""
"\"clientInfo\""
"\"name\""
"\"version\""
"\"cursor\""

"\"arguments\""
"\"documentId\""
"doc-1"
"\"path\""
"\"anchor\""
"\"position\""
"\"end\""
"\"text\""
"\"overwrite\""
"\"operations\""

"create_document"
"open_document"
"save_document"
"close_document"
"insert_paragraph"
"read_blocks"
"get_document_model"
