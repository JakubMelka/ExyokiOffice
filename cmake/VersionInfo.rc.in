#include <winres.h>

// The fourth field of FILEVERSION/PRODUCTVERSION is the build number and stays
// 0: RC requires four integers there, and the ABI version is MAJOR.MINOR, which
// the first two fields already carry.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @RC_FILE_TYPE@
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Jakub Melka"
            VALUE "FileDescription", "@RC_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@RC_INTERNAL_NAME@"
            VALUE "LegalCopyright", "Copyright (c) 2026 Jakub Melka and Contributors. MIT licensed."
            VALUE "LegalTrademarks", "Microsoft, Word, Excel and PowerPoint are trademarks of the Microsoft Corporation. This product is not affiliated with or endorsed by Microsoft."
            VALUE "OriginalFilename", "@RC_ORIGINAL_FILENAME@"
            VALUE "ProductName", "ExyokiOffice"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
